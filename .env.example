# Copia este archivo como .env.local para trabajar en tu ordenador,
# o crea estas mismas variables en Vercel (Settings > Environment Variables).
# NUNCA subas un archivo .env.local ni claves secretas a GitHub.

# Supabase > Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Nombre de la plataforma (se cambia aquí, sin tocar código)
NEXT_PUBLIC_APP_NAME=eBeat

# Comisión de la plataforma en %, por ejemplo 15. Déjalo vacío hasta decidirla.
NEXT_PUBLIC_COMMISSION_PERCENT=

# --- Pagos (Stripe). Son SECRETAS: solo en Vercel, nunca en el código ni en GitHub ---
# Stripe > Desarrolladores > Claves de API (clave secreta, empieza por sk_)
STRIPE_SECRET_KEY=
# Stripe > Desarrolladores > Webhooks > tu endpoint (empieza por whsec_)
STRIPE_WEBHOOK_SECRET=
# Supabase > Project Settings > API Keys > secret (empieza por sb_secret_)
SUPABASE_SERVICE_ROLE_KEY=
# Dirección pública de la web (opcional), por ejemplo https://ebeat-supabase.vercel.app
NEXT_PUBLIC_SITE_URL=
